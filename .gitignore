# Terraform's downloaded plugins (re-created by `terraform init`)
.terraform/

# State files describe your real AWS resources and can contain sensitive data.
# Never commit them.
*.tfstate
*.tfstate.*

# Saved plans and crash logs
*.tfplan
crash.log
crash.*.log

# Your personal variable values
*.tfvars
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl IS committed on purpose - it pins provider versions.
